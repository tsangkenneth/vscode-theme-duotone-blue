    "minimap.findMatchHighlight": "#ecce93",
    "minimap.errorHighlight": "#ecce93",
    "minimap.warningHighlight": "#ecce93"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#d7eefe"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b9e1fd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": [
        "entity.name.selector",
        "entity.name.tag",
        "punctuation.tag",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#d7eefe"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ecce93",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#668499",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": [
        "meta.preprocessor.string",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "scope": "meta.header.diff",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#8fc7ef"
      }
    },
    {
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "string.entity"
      ],
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "scope": "string.escape",
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": "string.quasi",
      "settings": {
        "foreground": "#d7eefe"
      }
    },
    {
      "scope": "object",
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": "module.node",
      "settings": {
        "foreground": "#d7eefe"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#8fc7ef"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "keyword.control.module",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "keyword.control.less",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#668499"
      }
    },
    {
      "scope": "keyword.operator.new",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "scope": "metatag.php",
      "settings": {
        "foreground": "#e4b558"
      }
    },
    {
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#8fc7ef"
      }
    },
    {
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#ecce93"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type.name",
        "meta.return.type",
        "meta.return-type",
        "meta.cast",
        "meta.type.annotation",
        "support.type",
        "storage.type.cs",
        "variable.class"
      ],
      "settings": {
        "foreground": "#8fc7ef"
      }
    },
    {
      "scope": [
        "variable.this",
        "support.variable"
      ],
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "name": "Definitions and functions",
      "scope": [
        "entity.name",
        "entity.static",
        "entity.name.class.static.function",
        "entity.name.function",
        "entity.name.class",
        "entity.name.type",
        "entity.function",
        "entity.name.function.static",
        "entity.name.function.function-call",
        "entity.name.method",
        "entity.name.method.function-call",
        "entity.name.static.function-call"
      ],
      "settings": {
        "foreground": "#d7eefe"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "meta.parameter.type.variable",
        "variable.parameter",
        "variable.name",
        "variable.other",
        "variable",
        "string.constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": "support.function.builtin",
      "settings": {
        "foreground": "#8fc7ef"
      }
    },
    {
      "scope": [
        "brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#668499"
      }
    },
    {
      "scope": "punctuation.quoted",
      "settings": {
        "foreground": "#b9e1fd"
      }
    },
    {
      "scope": "punctuation.quasi",
      "settings": {
        "foreground": "#668499"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#b9e1fd",
    "class": "#b9e1fd",
    "enum": "#b9e1fd",
    "interface": "#b9e1fd",
    "struct": "#b9e1fd",
    "type": "#b9e1fd",
    "typeParameter": "#b9e1fd",
    "function": "#b9e1fd",
    "method": "#b9e1fd",
    "macro": "#b9e1fd",
    "decorator": "#b9e1fd",
    "namespace.declaration": "#d7eefe",
    "class.declaration": "#d7eefe",
    "enum.declaration": "#d7eefe",
    "interface.declaration": "#d7eefe",
    "struct.declaration": "#d7eefe",
    "type.declaration": "#d7eefe",
    "function.declaration": "#d7eefe",
    "method.declaration": "#d7eefe",
    "macro.declaration": "#d7eefe",
    "namespace.definition": "#d7eefe",
    "class.definition": "#d7eefe",
    "enum.definition": "#d7eefe",
    "interface.definition": "#d7eefe",
    "struct.definition": "#d7eefe",
    "type.definition": "#d7eefe",
    "function.definition": "#d7eefe",
    "method.definition": "#d7eefe",
    "macro.definition": "#d7eefe",
    "variable": "#b9e1fd",
    "parameter": "#b9e1fd",
    "property": "#b9e1fd",
    "enumMember": "#ecce93",
    "*.readonly": "#ecce93"
  }
}
