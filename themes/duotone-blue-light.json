    "minimap.warningHighlight": "#895d06"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#246789",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.arguments"
      ],
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": [
        "entity.name.selector",
        "entity.name.tag",
        "punctuation.tag",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#895d06",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#6297b2",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": [
        "meta.preprocessor.string",
        "meta.preprocessor.numeric"
      ],
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "scope": "meta.header.diff",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": [
        "string",
        "string.tag",
        "string.value",
        "string.entity"
      ],
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "scope": "string.escape",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "string.quasi",
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": "object",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "module.node",
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "keyword.control.module",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "keyword.control.less",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#6297b2"
      }
    },
    {
      "scope": "keyword.operator.new",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "scope": "metatag.php",
      "settings": {
        "foreground": "#a7781b"
      }
    },
    {
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#895d06"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type.name",
        "meta.return.type",
        "meta.return-type",
        "meta.cast",
        "meta.type.annotation",
        "support.type",
        "storage.type.cs",
        "variable.class"
      ],
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "scope": [
        "variable.this",
        "support.variable"
      ],
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "name": "Definitions and functions",
      "scope": [
        "entity.name",
        "entity.static",
        "entity.name.class.static.function",
        "entity.name.function",
        "entity.name.class",
        "entity.name.type",
        "entity.function",
        "entity.name.function.static",
        "entity.name.function.function-call",
        "entity.name.method",
        "entity.name.method.function-call",
        "entity.name.static.function-call"
      ],
      "settings": {
        "foreground": "#06202d"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "meta.parameter.type.variable",
        "variable.parameter",
        "variable.name",
        "variable.other",
        "variable",
        "string.constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "support.function.builtin",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": [
        "brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#6297b2"
      }
    },
    {
      "scope": "punctuation.quoted",
      "settings": {
        "foreground": "#246789"
      }
    },
    {
      "scope": "punctuation.quasi",
      "settings": {
        "foreground": "#6297b2"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#246789",
    "class": "#246789",
    "enum": "#246789",
    "interface": "#246789",
    "struct": "#246789",
    "type": "#246789",
    "typeParameter": "#246789",
    "function": "#246789",
    "method": "#246789",
    "macro": "#246789",
    "decorator": "#246789",
    "namespace.declaration": "#06202d",
    "class.declaration": "#06202d",
    "enum.declaration": "#06202d",
    "interface.declaration": "#06202d",
    "struct.declaration": "#06202d",
    "type.declaration": "#06202d",
    "function.declaration": "#06202d",
    "method.declaration": "#06202d",
    "macro.declaration": "#06202d",
    "namespace.definition": "#06202d",
    "class.definition": "#06202d",
    "enum.definition": "#06202d",
    "interface.definition": "#06202d",
    "struct.definition": "#06202d",
    "type.definition": "#06202d",
    "function.definition": "#06202d",
    "method.definition": "#06202d",
    "macro.definition": "#06202d",
    "variable": "#246789",
    "parameter": "#246789",
    "property": "#246789",
    "enumMember": "#895d06",
    "*.readonly": "#895d06"
  }
}
